// HS-Square Technologies — foundation schema (Prisma)
// This is the first slice of the full schema you supplied
// (hs_square_software_database_schema_v1_fixed.sql): platform,
// multi-tenancy, users/RBAC. CRM/Inventory/Sales/Finance/HR/Projects/
// Helpdesk tables come in follow-up slices as those modules are built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 0. PLATFORM STAFF (not in the original schema) ----------
// The original schema ties every `users` row to a tenant_id NOT NULL,
// but Platform Admin (super admin) isn't scoped to any one tenant —
// they manage all of them. Modeled separately rather than forcing a
// fake "platform" tenant into the tenant table.

model PlatformAdmin {
  platformAdminId BigInt    @id @default(autoincrement()) @map("platform_admin_id")
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String?   @map("last_name")
  status          String    @default("ACTIVE") // ACTIVE | LOCKED | DISABLED
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  @@map("platform_admins")
}

// ---------- 1. PLATFORM / MULTI-TENANCY ----------

model Plan {
  planId       BigInt   @id @default(autoincrement()) @map("plan_id")
  code         String   @unique
  name         String
  description  String?
  monthlyPrice Decimal  @default(0) @map("monthly_price") @db.Decimal(19, 4)
  annualPrice  Decimal  @default(0) @map("annual_price") @db.Decimal(19, 4)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")
  tenants      Tenant[]

  @@map("plans")
}

model Module {
  moduleId    BigInt         @id @default(autoincrement()) @map("module_id")
  code        String         @unique
  name        String
  description String?
  version     String?
  isCore      Boolean        @default(false) @map("is_core")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @map("updated_at")
  tenants     TenantModule[]
  permissions Permission[]

  @@map("modules")
}

model Tenant {
  tenantId     BigInt         @id @default(autoincrement()) @map("tenant_id")
  planId       BigInt?        @map("plan_id")
  plan         Plan?          @relation(fields: [planId], references: [planId])
  legalName    String         @map("legal_name")
  displayName  String         @map("display_name")
  slug         String         @unique
  industry     String?
  taxId        String?        @map("tax_id")
  baseCurrency String         @default("INR") @map("base_currency") @db.Char(3)
  timezone     String         @default("Asia/Kolkata")
  locale       String         @default("en-IN")
  status       String         @default("TRIAL") // TRIAL | ACTIVE | SUSPENDED | CANCELLED | ARCHIVED
  trialEndsAt  DateTime?      @map("trial_ends_at")
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @map("updated_at")
  modules      TenantModule[]
  users        User[]
  roles        Role[]

  @@map("tenants")
}

model TenantModule {
  tenantId  BigInt   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  moduleId  BigInt   @map("module_id")
  module    Module   @relation(fields: [moduleId], references: [moduleId])
  enabled   Boolean  @default(true)
  settings  Json     @default("{}")
  enabledAt DateTime @default(now()) @map("enabled_at")

  @@id([tenantId, moduleId])
  @@map("tenant_modules")
}

// ---------- 2. USERS / RBAC ----------

model User {
  userId       BigInt     @id @default(autoincrement()) @map("user_id")
  tenantId     BigInt     @map("tenant_id")
  tenant       Tenant     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  email        String
  passwordHash String?    @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String?    @map("last_name")
  phone        String?
  status       String     @default("INVITED") // INVITED | ACTIVE | LOCKED | DISABLED
  lastLoginAt  DateTime?  @map("last_login_at")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @map("updated_at")
  roles        UserRole[]

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  roleId       BigInt           @id @default(autoincrement()) @map("role_id")
  tenantId     BigInt?          @map("tenant_id") // null = global/system role
  tenant       Tenant?          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  code         String
  name         String
  description  String?
  isSystemRole Boolean          @default(false) @map("is_system_role")
  createdAt    DateTime         @default(now()) @map("created_at")
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  permissionId BigInt           @id @default(autoincrement()) @map("permission_id")
  moduleId     BigInt?          @map("module_id")
  module       Module?          @relation(fields: [moduleId], references: [moduleId])
  code         String           @unique
  name         String
  description  String?
  roles        RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permissionId BigInt     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId BigInt @map("user_id")
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  roleId BigInt @map("role_id")
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}
